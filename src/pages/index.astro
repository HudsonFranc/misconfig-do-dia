---
import Base from '../layouts/Base.astro';
import { listarCenarios } from '../lib/cenarios';

const cenarios = listarCenarios();
---

<Base title="Misconfig do Dia">
  <h1>🐛 Misconfig do Dia</h1>
  <p>Um cenário de segurança cloud por dia, para iniciantes.</p>

  <p><strong>{cenarios.length} cenários disponíveis.</strong></p>

  <ul>
    {cenarios.map((c) => (
      <li>
        <a href={`${import.meta.env.BASE_URL}/cenario/${c.slug}`}>
          {c.titulo}
        </a>
        {' — '}
        <small>{c.servico} · {c.data}</small>
      </li>
    ))}
  </ul>

  <footer>
    <a href="https://github.com/HudsonFranc/misconfig-do-dia">
      Contribua no GitHub
    </a>
  </footer>
</Base>