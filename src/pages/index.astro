---
import Base from '../layouts/Base.astro';
import { listarCenarios } from '../lib/cenarios';

const cenarios = listarCenarios();
// Remove a barra final para não gerar "//cenario/..." quando o base é "/"
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Misconfig do Dia">
  <p><strong>{cenarios.length} cenários disponíveis.</strong></p>

  <ul>
    {cenarios.map((c) => (
      <li>
        <a href={`${base}/cenario/${c.slug}`}>{c.titulo}</a>
        {' — '}
        <small>{[c.servico, c.data].filter(Boolean).join(' · ')}</small>
      </li>
    ))}
  </ul>
</Base>